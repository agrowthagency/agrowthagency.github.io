---
import BaseLayout from '../layouts/BaseLayout.astro';
import { companyMetrics, companyProfileUrl, editorialLead } from '../data/authority';

const pageUrl = new URL('/about/', Astro.site).href;
const organizationId = new URL('/#organization', Astro.site).href;
const personId = `${editorialLead.profileUrl}#person`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'AGrowth',
      url: 'https://agrowth.io/',
      logo: {
        '@type': 'ImageObject',
        url: new URL('/brand/agrowth-mark-640.webp', Astro.site).href,
        width: 640,
        height: 640
      },
      sameAs: [
        'https://agrowth.io/',
        'https://github.com/agrowthagency'
      ],
      employee: {
        '@id': personId
      }
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: editorialLead.name,
      jobTitle: editorialLead.role,
      worksFor: { '@id': organizationId },
      url: editorialLead.profileUrl
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'About AGrowth', item: pageUrl }
      ]
    }
  ]
};
---

<BaseLayout title="About AGrowth" description="Learn about the AGrowth team and editorial approach behind its advertising account restriction, appeal, compliance, and preventive operations guidance." structuredData={structuredData} pageType="AboutPage" mainEntityId={organizationId}>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <nav class="page-breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <span aria-current="page">About AGrowth</span>
      </nav>
      <p class="eyebrow">About AGrowth</p>
      <h1>How AGrowth approaches restrictions, appeals, and account operations.</h1>
      <p class="lede">The AGrowth team organizes platform notices, affected assets, corrective actions, appeal evidence, and preventive controls into practical paths for Meta, Google, and TikTok advertisers.</p>
    </div>
  </section>
  <section class="section section--white">
    <div class="container info-layout">
      <div class="info-aside">
        <p class="eyebrow">Our focus</p>
        <p>Meta Ads · Google Ads · TikTok Ads · Appeals · Compliance · Agency accounts</p>
      </div>
      <div class="prose">
        <h2>Built around the account decisions operators actually face.</h2>
        <p>A restriction or suspension can involve policy, billing, identity, business verification, security, destinations, or connected assets. The Desk helps operators identify the affected level, preserve evidence, and correct verified causes before requesting review.</p>
        <p>Coverage starts with Meta account restrictions, Google Ads suspensions, and TikTok Ads or Business Center enforcement, then extends to appeal preparation, agency account controls, and operations designed to reduce repeat issues.</p>
        <h3>Independent guidance</h3>
        <p>AGrowth is not Meta, Google, or TikTok, and does not control their enforcement decisions. Platform names and trademarks belong to their respective owners.</p>
        <h3>Responsible operations</h3>
        <p>Our editorial approach favors accurate business information, documented access, secure payment operations, transparent provider relationships, and compliance with applicable platform policies.</p>
      </div>
    </div>
  </section>
  <section class="section about-authority">
    <div class="container">
      <div class="section-heading">
        <div><p class="eyebrow">Company experience</p><h2>Company figures with a published source.</h2></div>
        <p>These figures are reported on AGrowth’s primary company website and linked for direct verification.</p>
      </div>
      <div class="trust-metrics trust-metrics--about">
        {companyMetrics.map((metric) => (
          <div class="trust-metric"><strong>{metric.value}</strong><span>{metric.label}</span></div>
        ))}
      </div>
      <a class="trust-source" href={companyProfileUrl} rel="external">View the AGrowth company profile <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="section section--white">
    <div class="container editorial-profile">
      <div>
        <p class="eyebrow">Editorial leadership</p>
        <h2>{editorialLead.name}</h2>
        <p class="editorial-role">{editorialLead.role}</p>
      </div>
      <div class="prose">
        <p>{editorialLead.description}</p>
        <p>AGrowth’s primary blog identifies Alan Tran as the author of its platform guides and current advertising-industry coverage. Ad Account Desk articles are published under AGrowth’s organizational authorship and reviewed by the AGrowth editorial team.</p>
        <a class="button button--dark" href={editorialLead.profileUrl} rel="external">View published author profile <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
